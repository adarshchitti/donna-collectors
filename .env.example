# Bright Data -- the only fetch path. Copy to .env (gitignored) and fill in.
# A bare `npm run collect` replays saved fixtures and needs none of this.
BRIGHTDATA_API_KEY=
# Zone NAMES from the Bright Data console -- ours are web_unlocker1 / serp_api1.
# BOTH are required for --live: six of the eight collectors unlock a page, and
# a missing unlocker zone fails them all before any request is made.
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=
