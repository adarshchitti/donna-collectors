{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext",
    "moduleResolution": "bundler", "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "skipLibCheck": true, "verbatimModuleSyntax": true, "noEmit": true
  },
  "include": ["src/**/*"]
}
